# Build output: assembled binaries. Safe to delete.
build/

# Disk images. Ignored, but NOT build output: what programs save lives
# here and has to survive a clean build (docs/filesystem.md).
disks/

# Crash/debug dumps
ram.bin
*.bin.bak

# Python
__pycache__/
*.py[cod]
.pytest_cache/
venv/
.venv/

# Editors / IDEs
.idea/
.vscode/
*.swp

# PyPy, extracted here so it stays out of the system Python and every
# other project. Delete this folder to remove it entirely.
.pypy/
